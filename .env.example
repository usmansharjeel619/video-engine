# 100% FREE Auto-Publisher Config (scripts/publish_free.py)

# 1. YouTube Shorts (Official YouTube Data API v3 - Free)
# Download OAuth Desktop Client JSON from Google Cloud Console -> place at .creds/youtube_client_secret.json
YOUTUBE_CLIENT_SECRETS=.creds/youtube_client_secret.json
YOUTUBE_TOKEN_PATH=.creds/youtube_token.json

# 2. Instagram Reels (instagrapi - Free)
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
IG_SESSION_PATH=.creds/ig_session.json

# 3. TikTok (Optional, free cookie-based uploader via tiktok-uploader)
TIKTOK_COOKIES_PATH=.creds/tiktok_cookies.txt
